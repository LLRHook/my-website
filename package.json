{
  "name": "my-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "assets": "node scripts/render-assets.mjs",
    "token-stats": "node scripts/token-stats.mjs",
    "images": "node scripts/optimize-images.mjs",
    "resume:pdf": "node scripts/render-resume.mjs",
    "test:rust": "cargo test --release --locked --manifest-path tools/token-stats/Cargo.toml",
    "check:rust": "cargo fmt --check --manifest-path tools/token-stats/Cargo.toml && cargo clippy --locked --manifest-path tools/token-stats/Cargo.toml --all-targets -- -D warnings",
    "benchmark:tokens": "node scripts/benchmark-token-stats.mjs"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^24.15.0"
  }
}
