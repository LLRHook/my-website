{
  "name": "my-website",
  "version": "0.8.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:game && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "assets": "node scripts/render-assets.mjs",
    "build:game": "tsc -p game/tsconfig.json",
    "dev:game": "tsc -p game/tsconfig.json --watch"
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "typescript": "6.0.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^24.15.0"
  }
}
